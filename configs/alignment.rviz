Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Ground (10 cm)
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Alpha: 0.3
      Color: 115; 125; 145
      Reference Frame: panda_base
    - Class: rviz/MarkerArray
      Name: Franka and GELLO alignment
      Enabled: true
      Marker Topic: /pi05_alignment/markers
      Queue Size: 1
  Global Options:
    Background Color: 25; 29; 40
    Fixed Frame: panda_base
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 2.15
      Focal Point:
        X: 0.25
        Y: -0.30
        Z: 0.55
      Pitch: 0.25
      Yaw: 0.90
      Target Frame: panda_base
Window Geometry:
  Width: 1750
  Height: 980
  X: 40
  Y: 30
